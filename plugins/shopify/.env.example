# Ax402 control plane (merchant API key with apiManager scopes)
AX402_BASE_URL=http://api.localhost:8090

# Encrypt stored merchant API keys (required in production)
SHOPIFY_ENCRYPTION_SECRET=change-me-in-production

# Dev: mock Shopify session and sample products (set to 0 for production)
SHOPIFY_DEV_MODE=1
SHOPIFY_DEV_SHOP=demo.myshopify.com

# Shopify app (Partner Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products
