{
  "name": "@axlabs/ax402-sdk",
  "version": "0.2.0",
  "description": "Ax402 platform control-plane SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./buyer": {
      "types": "./dist/buyer/index.d.ts",
      "import": "./dist/buyer/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "import": "./dist/platform/index.js"
    },
    "./scopes": {
      "types": "./dist/scopes.d.ts",
      "import": "./dist/scopes.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "import": "./dist/shell/index.js"
    }
  },
  "files": ["dist", "src", "tsconfig.json"],
  "scripts": {
    "build": "tsc",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {},
  "optionalDependencies": {
    "@x402/fetch": "^2.12.0",
    "@x402/evm": "^2.12.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "~3.0.9"
  },
  "license": "Apache-2.0"
}
